{
  "author": "Dominykas Gudauskas <leneti>",
  "name": "yaml-fm-lint",
  "displayName": "YAML-fm Linter",
  "description": "A Markdown YAML front matter linter extension for VS Code",
  "version": "1.2.4",
  "publisher": "leneti",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Linters"
  ],
  "icon": "images/logo2.png",
  "galleryBanner": {
    "color": "#282828",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "bundle": "node esbuild.mjs",
    "check-types": "tsc -p ./ --noEmit",
    "compile-tests": "tsc -p ./",
    "lint": "eslint src",
    "pretest": "npm run compile-tests && npm run bundle && npm run lint",
    "test": "node ./out/test/runTest.js",
    "test:unit": "mocha --ui tdd \"out/test/unit/**/*.test.js\"",
    "vscode:prepublish": "npm run check-types && node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "~22.20.5",
    "@types/vscode": "~1.101.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "glob": "^14.0.3",
    "mocha": "^12.0.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "yaml-fm-lint": "^1.6.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leneti/yaml-fm-lint-ext.git"
  },
  "bugs": {
    "url": "https://github.com/leneti/yaml-fm-lint-ext/issues"
  },
  "homepage": "https://github.com/leneti/yaml-fm-lint-ext#readme"
}
